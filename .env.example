# ASTRION – Environment Configuration Template
# Copy this file to '.env' in the project root to configure local keys.
# DO NOT commit real secrets or your '.env' file to version control.

# NASA Open APIs Key (https://api.nasa.gov/)
# Expo exposes environment variables prefixed with EXPO_PUBLIC_ to client-side code.
# If omitted or left empty, the application automatically falls back to 'DEMO_KEY'
# (DEMO_KEY rate limits: 30 requests per hour, 50 requests per day).
EXPO_PUBLIC_NASA_API_KEY=DEMO_KEY
